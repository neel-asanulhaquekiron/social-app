# Copy to .env and fill in. NEVER commit the real .env — the service-role key bypasses RLS.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service role key>
PORT=4000
JWT_SECRET=<long random string, e.g. openssl rand -base64 48>
SUPABASE_ANON_KEY=<supabase publishable/anon key, same as the app uses>
# optional
NODE_ENV=production            # development enables pretty logs + detailed error messages
CORS_ORIGINS=                  # comma-separated browser origins allowed to call the API (native apps unaffected)
LOG_LEVEL=info
